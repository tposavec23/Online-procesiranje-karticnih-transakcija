# Korisnik u bazi (administrator), stvara se pri prvom pokretanju (Nije potrebno mijenjat)
POSTGRES_USER=sevenpay_admin

# Lozinka tog korisnika; upiši svoju prije prvog pokretanja
POSTGRES_PASSWORD=change-me

# Ime baze u kojoj su sheme account, catalogue i transaction (Nije potrebno mijenjati)
POSTGRES_DB=sevenpay

# Port na tvom računalu na kojem je dostupna baza iz Dockera.
# Lokalno instaliran PostgreSQL po defaultu koristi 5432, pa Docker baza
# koristi 5433 da ne dođe do sukoba. Preporuka: ostavi 5433; ako je i on
# zauzet, stavi bilo koji slobodan port iznad 1024.
POSTGRES_PORT=5433

# Baza na koju Go servisi trenutno ciljaju; ostavi aktivan samo redak baze koju želiš koristiti
# Baza u Dockeru
DATABASE_URL="postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:${POSTGRES_PORT}/${POSTGRES_DB}"
# Lokalno instaliran PostgreSQL (upiši svog korisnika, lozinku i ime baze)
# DATABASE_URL="postgres://postgres:lozinka@localhost:5432/sevenpay"
