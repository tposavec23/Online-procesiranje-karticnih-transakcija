# Database user (administrator), created on first start (no need to change)
POSTGRES_USER=sevenpay_admin

# Password of that user; set your own before the first start
POSTGRES_PASSWORD=change-me

# Name of the database that holds the account, catalogue and transaction schemas (no need to change)
POSTGRES_DB=sevenpay

# Port on your computer where the Docker database is available.
# A locally installed PostgreSQL uses 5432 by default, so the Docker database
# uses 5433 to avoid a conflict. Recommendation: keep 5433; if it is also
# taken, use any free port above 1024.
POSTGRES_PORT=5433

# Database the Go services connect to; leave only the line for the database you want to use uncommented
# Database in Docker
DATABASE_URL="postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:${POSTGRES_PORT}/${POSTGRES_DB}"
# Locally installed PostgreSQL (enter your own user, password and database name)
# DATABASE_URL="postgres://postgres:password@localhost:5432/sevenpay"
